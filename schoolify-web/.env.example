# PostgreSQL connection string. `docker compose up -d` starts a local instance matching this.
DATABASE_URL=postgresql://schoolify:schoolify_dev_password@localhost:5434/schoolify
# Used to sign the secure session cookie. Generate a long random value for production.
SESSION_SECRET=change-me-to-a-long-random-secret
# Public URL of the application, without a trailing slash.
APP_URL=http://localhost:3000
# Optional: enables transactional confirmation and startup notification emails via Resend.
RESEND_API_KEY=
EMAIL_FROM=Schoolify <onboarding@your-domain.com>
STARTUP_NOTIFICATION_EMAIL=
# Optional webhook: Google Apps Script, CRM, or integration backend.
INTEGRATION_WEBHOOK_URL=
INTEGRATION_WEBHOOK_SECRET=
# Optional URL provided by the teammate's chatbot backend. It receives POST { message }
# and should respond with JSON: { "reply": "..." }.
NEXT_PUBLIC_CHATBOT_API_URL=
