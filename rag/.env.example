# Schoolify RAG service
APP_ENV=development

# PostgreSQL + pgvector database started by docker compose.
# For a process running directly on Windows use localhost; docker-compose uses its own db hostname.
DATABASE_URL=postgresql://schoolify_rag:schoolify_rag_dev_password@localhost:5435/schoolify_rag
# Optional override when the API container needs a different database URL.
RAG_DOCKER_DATABASE_URL=

# LLM: Groq's OpenAI-compatible endpoint through LangChain ChatOpenAI.
# Leave LLM_API_KEY blank locally to reuse ../ai-service/.env automatically.
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=45
# Optional path to the existing chatbot environment when the services are separated.
CHATBOT_ENV_FILE=../ai-service/.env

# Local multilingual embedding model used for retrieval.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
# Leave blank to use a platform-safe cache location (important on OneDrive/Windows).
EMBEDDING_CACHE_DIR=

# Optional ElevenLabs text-to-speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Protect the service when it is not behind the Next.js proxy.
RAG_API_KEY=
CORS_ORIGINS=http://localhost:3000

# The API can create the table and index the bundled knowledge at startup.
AUTO_INGEST=true
KNOWLEDGE_DIR=data/knowledge
UPLOAD_DIR=data/knowledge/uploads
ALLOWED_UPLOAD_EXTENSIONS=.md,.txt,.pdf
MAX_UPLOAD_MB=20
MAX_CONTEXT_DOCUMENTS=5
MAX_HISTORY_MESSAGES=8
CHUNK_SIZE=1200
CHUNK_OVERLAP=160
